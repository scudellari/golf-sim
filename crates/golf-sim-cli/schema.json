        "penalties": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "rest": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "maxItems": 3,
          "minItems": 3
        },
        "rest_surface": {
          "$ref": "#/$defs/Surface2"
